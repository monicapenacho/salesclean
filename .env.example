# =============================================================================
# SalesClean - Plantilla de variables de entorno
# Copia este archivo a `.env` y rellena los valores reales.
# NUNCA subas el .env real a Git. Está en .gitignore por algo.
# =============================================================================

# --- Entorno ---
ENV=local                          # local | dev | prod
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR

# --- Azure Storage ---
# En local (Azurite) usa esta connection string especial:
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEhoTuKcHqGXCk6+6BvVr8nM5DKvLKkz1DQIw7K6hYvmfKbg7aXJvBs0Q==;BlobEndpoint=http://azurite:10000/devstoreaccount1;
AZURE_STORAGE_ACCOUNT=devstoreaccount1
AZURE_CONTAINER_RAW=raw
AZURE_CONTAINER_CURATED=curated

# En Azure real (cuando despliegues), sustituye por:
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=salescleanprod;AccountKey=...;EndpointSuffix=core.windows.net
# o, mejor, usa Managed Identity y deja la conn string vacía.

# --- Prefect ---
PREFECT_API_URL=http://prefect-server:4200/api
PREFECT_LOGGING_LEVEL=INFO

# --- Alertas (opcional) ---
ALERT_WEBHOOK_URL=                 # webhook de Teams/Slack/Discord para fallos
ALERT_EMAIL_TO=                    # email donde mandar alertas críticas

# --- Pipeline ---
INPUT_FILE_NAME=ventas_dia.xlsx
OUTPUT_FILE_NAME=ventas_limpio.parquet
MIN_VALID_PRICE=0.01               # umbral de precio mínimo válido
QUALITY_THRESHOLD=0.95             # % mínimo de filas válidas para no fallar el flow
